# escape=`
# UNTESTED TEMPLATE -- Windows containers run ONLY on Windows hosts
# (Windows 10/11 Pro+ or Server with the Containers feature, Docker
# Desktop in Windows-containers mode). It cannot even be built on
# macOS or Linux, so nobody has run this yet. See issue #24.
#
# If you have a Windows host, please validate and report back:
#   1. docker build -f docker/Dockerfile.windows -t netscanner-test-win .
#   2. zig build + zig build test inside the container
#   3. ns -s against your LAN, scored against arp -a ground truth
#   4. Confirm the blocking-connect fallback + arp harvest behave
# Then delete this header and document what you had to change.
ARG ZIG_VERSION=0.16.0
FROM mcr.microsoft.com/windows/servercore:ltsc2022

ARG ZIG_VERSION
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop';"]

# C toolchain: NetScanner links libc and compiles ping.c, so the MSVC
# linker and a Windows SDK are required (Zig bundles neither).
RUN Invoke-WebRequest -Uri https://aka.ms/vs/17/release/vs_BuildTools.exe -OutFile $env:TEMP\vs.exe; `
    Start-Process -Wait -FilePath $env:TEMP\vs.exe -ArgumentList `
        '--quiet', '--wait', '--norestart', '--nocache', `
        '--add', 'Microsoft.VisualStudio.Workload.VCTools', `
        '--add', 'Microsoft.VisualStudio.Component.Windows11SDK.22621'; `
    Remove-Item $env:TEMP\vs.exe

# Zig itself. ping and arp ship with Windows, nothing else to install.
RUN Invoke-WebRequest `
        -Uri "https://ziglang.org/download/$env:ZIG_VERSION/zig-x86_64-windows-$env:ZIG_VERSION.zip" `
        -OutFile $env:TEMP\zig.zip; `
    Expand-Archive $env:TEMP\zig.zip -DestinationPath C:\opt; `
    Rename-Item "C:\opt\zig-x86_64-windows-$env:ZIG_VERSION" C:\opt\zig; `
    Remove-Item $env:TEMP\zig.zip

ENV PATH="C:\opt\zig;${PATH}"
WORKDIR C:\work
CMD ["powershell"]
