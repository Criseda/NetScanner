# NetScanner Linux test image: Zig toolchain + network tools.
# Lets anyone reproduce the Linux validation run (#28) without a
# Linux box. macOS/Windows containers don't exist, so Linux-only.
ARG ZIG_VERSION=0.16.0
FROM ubuntu:24.04

ARG ZIG_VERSION
ARG TARGETARCH

# Compiler (zig links libc and compiles ping.c), downloader, and the
# network tools the scanner and its ground-truth checks need:
# ping for the --ping path, arp for the harvest pass, ip for setup.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    iproute2 \
    iputils-ping \
    net-tools \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Zig publishes per-arch tarballs; map Docker's arch names to Zig's.
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64) ZIG_ARCH=x86_64 ;; \
        arm64) ZIG_ARCH=aarch64 ;; \
        *) echo "unsupported arch: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/zig.tar.xz \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz"; \
    mkdir -p /opt/zig; \
    tar -xf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; \
    rm /tmp/zig.tar.xz; \
    /opt/zig/zig version

ENV PATH="/opt/zig:${PATH}"
WORKDIR /work
CMD ["bash"]
